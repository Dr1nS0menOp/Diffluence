# Copy to .env and adjust. Any variable can be read from a file with the _FILE suffix,
# for example KENWERK_DATABASE_URL_FILE=/run/secrets/database_url
#
# Settings can also live in one YAML file (deploy/kenwerk.example.yaml). A variable here
# that is set and not empty wins over the file. Check either with: kenwerk config check
KENWERK_CONFIG_FILE=

# all | api | worker
KENWERK_ROLE=all
KENWERK_HTTP_ADDR=:8080
# The URL users open in their browser. Used for origin checks and secure cookies.
KENWERK_PUBLIC_URL=http://localhost:8080
KENWERK_INSTANCE_NAME=Kenwerk
# Address ranges of the reverse proxy, comma-separated, whose X-Forwarded-For is believed.
# Empty in compose.yaml = 127.0.0.0/8,::1/128,172.16.0.0/12, which fits its port on
# 127.0.0.1. Empty without Compose = trust nobody. With KENWERK_BIND=0.0.0.0, set the
# proxy's own address, for example 192.0.2.10/32.
KENWERK_TRUSTED_PROXIES=

# The application connects as a role that does not own the tables, so it cannot
# touch the audit log's protection. Migrations use the owner. compose.yaml reads neither
# from here: it gives the server only the application role and the backup service both,
# and the backup service migrates (spec 070). A node started without compose.yaml, with
# both set, migrates itself.
KENWERK_DATABASE_URL=postgres://kenwerk_app:change-me@localhost:5432/kenwerk?sslmode=disable
KENWERK_MIGRATE_DATABASE_URL=postgres://kenwerk_owner:change-me@localhost:5432/kenwerk?sslmode=disable
# A worker listens here for new events, as the application role. Behind PgBouncer in
# transaction mode point it at the database directly. Empty = KENWERK_DATABASE_URL.
KENWERK_LISTEN_DATABASE_URL=

# Empty = embedded NATS JetStream (single node). Set for an external NATS cluster.
KENWERK_NATS_URL=
# How many NATS nodes keep a copy of each event: 1, or 3 or 5 for a cluster.
KENWERK_NATS_REPLICAS=1
# Where the embedded NATS stores its data
KENWERK_DATA_DIR=./data

# false: this node never migrates, and waits on its page until another process did. The
# server of compose.yaml sets false, because the backup service migrates there.
KENWERK_MIGRATE_ON_START=true
KENWERK_LOG_LEVEL=info

KENWERK_SESSION_IDLE_TIMEOUT=8h
KENWERK_SESSION_MAX_AGE=168h

# Key that encrypts secrets such as TOTP seeds. Empty = DATA_DIR/master.key, created
# on first start. Required when ROLE is api or worker: every node needs the same key.
# Back this file up separately from the data.
KENWERK_MASTER_KEY_FILE=

# OpenID Connect login. Leave the issuer empty to turn it off.
KENWERK_OIDC_ISSUER=
KENWERK_OIDC_CLIENT_ID=
KENWERK_OIDC_CLIENT_SECRET_FILE=
KENWERK_OIDC_DISPLAY_NAME=Single sign-on
# Make an account at the first login of everyone the provider lets in. Off = only accounts
# that exist already, through SCIM or an invitation (docs/operations/identity-providers.md).
KENWERK_OIDC_AUTO_CREATE=false
# A new account needs an address the provider marks as verified, unless this is true.
KENWERK_OIDC_ALLOW_UNVERIFIED_EMAIL=false
# Name of the claim that lists groups. Empty = do not sync groups.
KENWERK_OIDC_GROUPS_CLAIM=

# Mail. Any SMTP server works. Without a host, mail is off and waits in the queue.
KENWERK_SMTP_HOST=
KENWERK_SMTP_PORT=587
KENWERK_SMTP_USERNAME=
KENWERK_SMTP_PASSWORD_FILE=
KENWERK_SMTP_FROM=
KENWERK_SMTP_REPLY_TO=
# starttls, implicit, or none. none is only for a relay on the same machine.
KENWERK_SMTP_TLS=starttls

# The optional draw.io service, in its own container on another origin. Empty = off.
# Never point this at embed.diagrams.net: it would tell an outside party who draws what.
KENWERK_DRAWING_URL=
