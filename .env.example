# Copy to .env and adjust. Any variable can be read from a file with the _FILE suffix,
# for example DIFFLUENCE_DATABASE_URL_FILE=/run/secrets/database_url

# all | api | worker
DIFFLUENCE_ROLE=all
DIFFLUENCE_HTTP_ADDR=:8080
# The URL users open in their browser. Used for origin checks and secure cookies.
DIFFLUENCE_PUBLIC_URL=http://localhost:8080
DIFFLUENCE_INSTANCE_NAME=Diffluence

# The application connects as a role that does not own the tables, so it cannot
# touch the audit log's protection. Migrations use the owner.
DIFFLUENCE_DATABASE_URL=postgres://diffluence_app:change-me@localhost:5432/diffluence?sslmode=disable
DIFFLUENCE_MIGRATE_DATABASE_URL=postgres://diffluence_owner:change-me@localhost:5432/diffluence?sslmode=disable

# Empty = embedded NATS JetStream (single node). Set for an external NATS cluster.
DIFFLUENCE_NATS_URL=
# Where the embedded NATS stores its data
DIFFLUENCE_DATA_DIR=./data

DIFFLUENCE_MIGRATE_ON_START=true
DIFFLUENCE_LOG_LEVEL=info

DIFFLUENCE_SESSION_IDLE_TIMEOUT=8h
DIFFLUENCE_SESSION_MAX_AGE=168h

# Key that encrypts secrets such as TOTP seeds. Empty = DATA_DIR/master.key, created
# on first start. Required when ROLE is api or worker: every node needs the same key.
# Back this file up separately from the data.
DIFFLUENCE_MASTER_KEY_FILE=

# OpenID Connect login. Leave the issuer empty to turn it off.
DIFFLUENCE_OIDC_ISSUER=
DIFFLUENCE_OIDC_CLIENT_ID=
DIFFLUENCE_OIDC_CLIENT_SECRET_FILE=
DIFFLUENCE_OIDC_DISPLAY_NAME=Single sign-on
DIFFLUENCE_OIDC_AUTO_CREATE=true
# Name of the claim that lists groups. Empty = do not sync groups.
DIFFLUENCE_OIDC_GROUPS_CLAIM=

# Mail. Any SMTP server works. Without a host, mail is off and waits in the queue.
DIFFLUENCE_SMTP_HOST=
DIFFLUENCE_SMTP_PORT=587
DIFFLUENCE_SMTP_USERNAME=
DIFFLUENCE_SMTP_PASSWORD_FILE=
DIFFLUENCE_SMTP_FROM=
DIFFLUENCE_SMTP_REPLY_TO=
# starttls, implicit, or none. none is only for a relay on the same machine.
DIFFLUENCE_SMTP_TLS=starttls

# The optional draw.io service, in its own container on another origin. Empty = off.
# Never point this at embed.diagrams.net: it would tell an outside party who draws what.
DIFFLUENCE_DRAWING_URL=
