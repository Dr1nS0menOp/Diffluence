# Always LF in the repository and in working trees, also on Windows:
# scripts run in Linux containers and gofmt rejects CRLF.
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary

# Other people's builds, pinned by hash: never touch their line endings.
web/public/vendor/pdfcraft/** -text
web/public/vendor/gridcraft/** -text