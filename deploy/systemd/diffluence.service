# Diffluence as a systemd service, for LXC containers and bare Linux.
[Unit]
Description=Diffluence wiki
Documentation=https://github.com/Dr1nS0menOp/Diffluence
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=diffluence
Group=diffluence
# Defaults that fit the sandbox below: the data, the key and the queue's store live in the
# one folder the service may write, and it listens for a reverse proxy on this machine.
# The environment file is read after these, so it may change them.
Environment=DIFFLUENCE_DATA_DIR=/var/lib/diffluence
Environment=DIFFLUENCE_HTTP_ADDR=127.0.0.1:8080
EnvironmentFile=/etc/diffluence/diffluence.env
ExecStart=/usr/local/bin/diffluence serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=45

# Sandboxing: the process sees almost nothing of the host.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
StateDirectory=diffluence
StateDirectoryMode=0700
ReadWritePaths=/var/lib/diffluence

[Install]
WantedBy=multi-user.target
