# The HA test topology of spec 062: one place for VM ids, sizes and roles.
# Sourced by the scripts in this folder. Addresses are on the test network only and are
# set by the operator in ha.local.env (never committed); see README.md.

# id  name              role    vcpu  mem_mb  disk_gb
HA_VMS="
910 diffluence-ha-db1    db      2     6144    60
911 diffluence-ha-db2    db      2     6144    60
912 diffluence-ha-db3    db      2     6144    60
913 diffluence-ha-nats1  nats    1     2048    20
914 diffluence-ha-nats2  nats    1     2048    20
915 diffluence-ha-nats3  nats    1     2048    20
916 diffluence-ha-edge   edge    2     2048    20
917 diffluence-ha-api1   api     2     4096    20
918 diffluence-ha-api2   api     2     4096    20
919 diffluence-ha-work1  worker  1     3072    20
920 diffluence-ha-work2  worker  1     3072    20
901 diffluence-stress-load load  4     8192    30
"

# Releases and images, pinned so a rerun builds the same thing.
HA_UBUNTU_IMAGE=noble-server-cloudimg-amd64.img
HA_NATS_VERSION=2.10.29
HA_STORAGE=vmdata
