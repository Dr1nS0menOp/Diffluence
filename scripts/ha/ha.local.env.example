# Copy to ha.local.env (ignored by git) and fill in. Addresses are on the test network.
HA_DB1=10.0.0.11
HA_DB2=10.0.0.12
HA_DB3=10.0.0.13
HA_NATS1=10.0.0.21
HA_NATS2=10.0.0.22
HA_NATS3=10.0.0.23
HA_EDGE=10.0.0.30
HA_API1=10.0.0.41
HA_API2=10.0.0.42
HA_WORK1=10.0.0.51
HA_WORK2=10.0.0.52
HA_GATEWAY=10.0.0.1
HA_PREFIX=24
# Secrets: generate fresh ones per run, for example with `openssl rand -hex 24`.
HA_PG_SUPERUSER_PASSWORD=
HA_PG_REPLICATION_PASSWORD=
HA_PG_OWNER_PASSWORD=
HA_PG_APP_PASSWORD=
HA_PATRONI_REST_PASSWORD=
# The one master.key every app node shares (OPS-011), as a local path.
HA_MASTER_KEY_FILE=
# The diffluence .deb to install on the app nodes, built by `goreleaser release --snapshot`.
HA_DEB=
# The NATS JetStream sync policy under test (OPS-083): default, 1s or always.
HA_NATS_SYNC=always
