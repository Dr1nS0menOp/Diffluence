#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# End-to-end tests: the real binary, real PostgreSQL, real Chromium.
# Run from WSL or Linux after scripts/dev up.
#   scripts/e2e                 all tests
#   scripts/e2e -g "passkey"    a selection (Playwright arguments)
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f compose.dev.yaml)

"${compose[@]}" exec -T dev sh -s <<'EOF'
set -e
cd /work/web && npx vite build >/dev/null
cd /work && CGO_ENABLED=0 go build -o /tmp/diffluence ./cmd/diffluence
[ -f /tmp/e2e.pid ] && kill "$(cat /tmp/e2e.pid)" 2>/dev/null || true
export PGPASSWORD=diffluence
psql -q -h db -U diffluence -d diffluence -c 'DROP DATABASE IF EXISTS diffluence_e2e WITH (FORCE)' -c 'CREATE DATABASE diffluence_e2e'
rm -rf /tmp/dfl-e2e
cat >/tmp/e2e-env <<ENV
export DIFFLUENCE_DATABASE_URL='postgres://diffluence:diffluence@db:5432/diffluence_e2e?sslmode=disable'
export DIFFLUENCE_PUBLIC_URL=http://localhost:8080
export DIFFLUENCE_DATA_DIR=/tmp/dfl-e2e
export DIFFLUENCE_SHUTDOWN_DELAY=0s
export DIFFLUENCE_EXAMPLE_SPACE=false
export DIFFLUENCE_LOG_LEVEL=warn
ENV
. /tmp/e2e-env
echo 'correct horse battery staple' | /tmp/diffluence user create-admin --email admin@example.com --name Admin >/dev/null
nohup /tmp/diffluence serve >/tmp/e2e.log 2>&1 &
echo $! >/tmp/e2e.pid
for i in $(seq 1 50); do
  curl -sf http://localhost:8080/readyz >/dev/null && break
  sleep 0.2
done
curl -sf http://localhost:8080/readyz
EOF

status=0
"${compose[@]}" --profile e2e run --rm -T e2e npx playwright test "$@" || status=$?
"${compose[@]}" exec -T dev sh -c 'kill "$(cat /tmp/e2e.pid)" 2>/dev/null; grep -iE "panic|\"level\":\"ERROR\"" /tmp/e2e.log | head -20; true' || true
exit "$status"
