    "lint": "eslint src e2e && prettier --check src e2e",
    "format": "prettier --write src e2e",
    "test": "vitest run",
    "strings": "node scripts/check-ui-strings.mjs",
    "design": "node scripts/check-design.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@tanstack/react-query": "^5.105.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bubble-menu": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-collaboration": "3.32.2",
    "@tiptap/extension-collaboration-caret": "3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@tiptap/y-tiptap": "3.2.0",
    "i18next": "^26.7.1",
    "lowlight": "^3.3.0",
    "react": "^19.3.1",
